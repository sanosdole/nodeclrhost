@page "/JSInterop"
@inject IJSRuntime JSRuntime
@using System.IO


<h1>JavaScript Interop</h1>

<h2>Invoke JavaScript functions from .NET methods</h2>

<input @ref="_entryInput" id="jsInteropInput"/>

<button id="triggerjsfromdotnet" type="button" class="btn btn-primary" @onclick="TriggerJsPrompt">
    Trigger JavaScript Prompt
</button>

<h3 id="welcome" style="color: green; font-style: italic"></h3>

<button id="triggerdotnetfromjs" type="button" class="btn" @onclick="TriggerNetInstanceMethod">
    Trigger .NET instance method HelloHelper.SayHello
</button>

<h3 id="dotnetinvocationcount" style="color: green; font-style: italic">@_invokeCounter</h3>

<h3>Import an ES module via IJSRuntime</h3>

<button id="triggermoduleimport" type="button" class="btn" @onclick="TriggerModuleImport">
    Import exampleJsImport.js and call getWelcomeMessage
</button>

<button id="releasemodule" type="button" class="btn" @onclick="ReleaseModule">
    Release module reference
</button>

<h3 id="moduleimportresult" style="color: green; font-style: italic">@_moduleMessage</h3>

<h3>Stream test</h3>

<button id="streamtest" type="button" class="btn" @onclick="TriggerStreamTest">
    Stream byte array from JS.
</button>


@code {
    private ElementReference _entryInput;
    private int _invokeCounter;
    private IJSObjectReference _importedModule;
    private string _moduleMessage;

    public async Task TriggerModuleImport()
    {
        try
        {
            // A real ES module is loaded at runtime: "./exampleJsImport.js" is resolved
            // relative to the document base URI before the actual dynamic import runs.
            _importedModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./exampleJsImport.js");
            _moduleMessage = await _importedModule.InvokeAsync<string>("getWelcomeMessage");
        }
        catch (Exception ex)
        {
            _moduleMessage = "EXCEPTION: " + ex.GetBaseException().Message;
        }
    }

    public async Task TriggerNetInstanceMethod()
    {
        await JSRuntime.InvokeAsync<string>(
            "exampleJsFunctions.sayHello",
            DotNetObjectReference.Create(this));
    }

    [JSInvokable]
    public string SayHello()
    {
        _invokeCounter++;
        StateHasChanged();
        return $"Hello, {_invokeCounter}!";
    }

    [JSInvokable]
    public static async Task AsyncVoidTest(DotNetObjectReference<JSInterop> instanceRef)
    {
        var instance = instanceRef.Value;
        instance._invokeCounter--;
        instance.StateHasChanged();
        await Task.Delay(100);
        instance._invokeCounter++;
        instance.StateHasChanged();
        await Task.Yield();
        instance._invokeCounter++;
        instance.StateHasChanged();
        instanceRef.Dispose();
    }

    public async Task TriggerJsPrompt()
    {
        var name = await JSRuntime.InvokeAsync<string>(
            "exampleJsFunctions.getInputValue",
            _entryInput);

        await JSRuntime.InvokeVoidAsync(
            "exampleJsFunctions.displayWelcome",
            $"Hello {name}! Welcome to Blazor!");
    }

    // Release the reference to the imported module once it is no longer needed.
    public async Task ReleaseModule()
    {
        if (_importedModule is not null)
        {
            await _importedModule.DisposeAsync();
            _importedModule = null;
            _moduleMessage = null;
        }
    }

    public async Task TriggerStreamTest()
    {
        var streamRef = await JSRuntime.InvokeAsync<IJSStreamReference>("exampleJsFunctions.getUInt8Array");
        var jsStream = await streamRef.OpenReadStreamAsync();
        var memStream = new MemoryStream();
        await jsStream.CopyToAsync(memStream);
        _invokeCounter = (int)memStream.Length;

    }

}